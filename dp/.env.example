# Docker 镜像与宿主机端口
DP_IMAGE=dp:latest
DP_PLATFORM=linux/amd64
DP_HTTP_PORT=30199

# 容器使用宿主机当前用户读写 ./data；dp.sh 首次运行时会自动填写。
DP_UID=1000
DP_GID=1000

# 必须长期保存。更换后，数据库中已有的 SSH 密码将无法解密。
DP_MASTER_KEY=请使用-dp.sh-自动生成

# 首次启动创建初始管理员；账号初始化后，修改这里不会重置数据库密码。
DP_ADMIN_USERNAME=admin
DP_ADMIN_PASSWORD=请使用-dp.sh-自动生成
DP_SESSION_TTL=24h
DP_STALE_ACCOUNT_DAYS=90

# 应用运行参数
DP_LISTEN_ADDR=127.0.0.1:30199
DP_DATA_DIR=./data
DP_HEALTH_INTERVAL=10s
DP_UPLOAD_TIMEOUT=10m
DP_UPLOAD_MAX_BYTES=32212254720
DP_LOG_LEVEL=info

# 管理员审计日志
DP_AUDIT_RETENTION_DAYS=180
DP_AUDIT_EXPORT_MAX_ROWS=100000
# 管理员通知、操作历史与安装包版本治理
DP_NOTIFICATION_RETENTION_DAYS=180
DP_OPERATION_RETENTION_DAYS=180
DP_PACKAGE_VERSION_RETENTION=10
# 部署在反向代理后且需要记录真实客户端 IP 时配置，例如：10.0.0.0/8,192.168.1.0/24
DP_TRUSTED_PROXY_CIDRS=
TZ=Asia/Shanghai
